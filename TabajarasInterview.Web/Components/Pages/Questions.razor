@page "/questions"
@attribute [Authorize]
@implements IDisposable
@inject IQuestionApiService QuestionApi
@inject IStackApiService StackApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Questions</PageTitle>

<div class="d-flex flex-wrap align-center mb-4">
    <div class="flex-grow-1 mr-4">
        <MudText Typo="Typo.h4">Questions</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Manage reusable interview questions, grouped by technology stack</MudText>
    </div>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="flex-wrap">
        <MudTooltip Text="Refresh">
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" OnClick="ReloadAsync" />
        </MudTooltip>
        <MudButton StartIcon="@Icons.Material.Filled.Add"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="OpenCreateDialogAsync"
                   Disabled="_stacks.Count == 0">
            Add question
        </MudButton>
    </MudStack>
</div>

@if (_loading)
{
    <LoadingState SkeletonRows="5" SkeletonHeight="52px" Message="Loading questions…" />
}
else if (_error is not null)
{
    <ErrorState Title="Could not load questions" Message="@_error" OnRetry="ReloadAsync" />
}
else
{
    <MudPaper Elevation="1" Class="pa-4 rounded-lg mb-4">
        <div class="d-flex flex-wrap align-center" style="gap: .75rem;">
            <MudTextField @bind-Value="_searchString"
                          Immediate="true"
                          Placeholder="Search by question or acceptable answer"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Clearable="true"
                          Style="width:300px;" />

            <MudSelect T="int?" Value="_stackFilter" ValueChanged="@(v => Apply(() => _stackFilter = v))"
                       Label="Stack" Clearable="true" Dense="true" Variant="Variant.Outlined"
                       Margin="Margin.Dense" Style="width:180px;">
                <MudSelectItem T="int?" Value="@((int?)null)">All stacks</MudSelectItem>
                @foreach (var stack in _stacks)
                {
                    <MudSelectItem T="int?" Value="@((int?)stack.Id)">@stack.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="string" Value="_levelFilter" ValueChanged="@(v => Apply(() => _levelFilter = v))"
                       Label="Level" Clearable="true" Dense="true" Variant="Variant.Outlined"
                       Margin="Margin.Dense" Style="width:160px;">
                <MudSelectItem T="string" Value="@((string?)null)">All levels</MudSelectItem>
                @foreach (var level in QuestionLevels.All)
                {
                    <MudSelectItem T="string" Value="@level">@level</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="QuestionSort" Value="_sort" ValueChanged="@(v => Apply(() => _sort = v))"
                       Label="Sort by" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:150px;">
                <MudSelectItem T="QuestionSort" Value="QuestionSort.Stack">Stack</MudSelectItem>
                <MudSelectItem T="QuestionSort" Value="QuestionSort.Level">Level</MudSelectItem>
            </MudSelect>

            <MudTooltip Text="@(_descending ? "Descending" : "Ascending")">
                <MudIconButton Icon="@(_descending ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.ArrowUpward)"
                               OnClick="@(() => Apply(() => _descending = !_descending))" />
            </MudTooltip>

            <MudSpacer />
            <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">
                @FilteredQuestions.Count of @_questions.Count question(s)
            </MudText>
        </div>
    </MudPaper>

    @if (_questions.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Filled.QuestionAnswer"
                    Title="No questions yet"
                    Description="Add your first interview question to get started.">
            <Actions>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled"
                           OnClick="OpenCreateDialogAsync" Disabled="_stacks.Count == 0">
                    Add question
                </MudButton>
            </Actions>
        </EmptyState>
    }
    else if (FilteredQuestions.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Filled.SearchOff"
                    Title="No matching questions"
                    Description="Try adjusting your search or filters." />
    }
    else
    {
        <MudTable T="QuestionResponse"
                  Items="FilteredQuestions"
                  GroupBy="_stackGroup"
                  Hover="true"
                  Striped="true"
                  Elevation="2"
                  Breakpoint="Breakpoint.Sm">
            <ColGroup>
                <col />
                <col />
                <col style="width: 110px;" />
                <col style="width: 130px;" />
            </ColGroup>
            <HeaderContent>
                <MudTh>Question</MudTh>
                <MudTh>Acceptable answer</MudTh>
                <MudTh>Level</MudTh>
                <MudTh Style="text-align:right;">Actions</MudTh>
            </HeaderContent>
            <GroupHeaderTemplate>
                <MudTh Class="mud-table-cell-custom-group" colspan="4">
                    <MudIcon Icon="@Icons.Material.Filled.Layers" Size="Size.Small" Class="mr-2" />
                    @context.Key
                </MudTh>
            </GroupHeaderTemplate>
            <RowTemplate>
                <MudTd DataLabel="Question">
                    <MudText Typo="Typo.body1">@context.Question</MudText>
                </MudTd>
                <MudTd DataLabel="Acceptable answer">
                    <MudTooltip Text="@context.AcceptableAnswer">
                        <MudText Typo="Typo.body2" Class="text-truncate" Style="max-width:420px;display:inline-block;">
                            @(string.IsNullOrWhiteSpace(context.AcceptableAnswer) ? "—" : context.AcceptableAnswer)
                        </MudText>
                    </MudTooltip>
                </MudTd>
                <MudTd DataLabel="Level">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@QuestionLevels.ColorFor(context.Level)">
                        @(context.Level ?? "—")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Actions" Style="text-align:right;">
                    <MudTooltip Text="View details">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                       OnClick="@(() => OpenDetailsAsync(context))" />
                    </MudTooltip>
                    <MudTooltip Text="Edit">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                       OnClick="@(() => OpenEditDialogAsync(context))" />
                    </MudTooltip>
                    <MudTooltip Text="Delete">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => ConfirmDeleteAsync(context))" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
            </PagerContent>
        </MudTable>
    }
}

@code {
    private List<QuestionResponse> _questions = [];
    private List<StackResponse> _stacks = [];
    private Dictionary<int, string> _stackNames = [];

    private bool _loading = true;
    private string? _error;

    private string _searchString = string.Empty;
    private int? _stackFilter;
    private string? _levelFilter;
    private QuestionSort _sort = QuestionSort.Stack;
    private bool _descending;

    private CancellationTokenSource? _cts;

    private TableGroupDefinition<QuestionResponse> _stackGroup = null!;

    protected override async Task OnInitializedAsync()
    {
        _stackGroup = new TableGroupDefinition<QuestionResponse>
        {
            Selector = q => GetStackName(q.StackId)
        };

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;

        try
        {
            var questionsTask = QuestionApi.GetQuestionsAsync(token);
            var stacksTask = StackApi.GetStacksAsync(token);
            await Task.WhenAll(questionsTask, stacksTask);

            var stacksResult = await stacksTask;
            if (stacksResult is { Success: true, Data: not null })
            {
                _stacks = stacksResult.Data;
                _stackNames = _stacks.ToDictionary(s => s.Id, s => s.Name);
            }
            else
            {
                _stacks = [];
                _stackNames = [];
                _error = stacksResult.ErrorMessage ?? "Could not load stacks.";
            }

            var questionsResult = await questionsTask;
            if (questionsResult is { Success: true, Data: not null })
            {
                _questions = questionsResult.Data;
            }
            else
            {
                _error ??= questionsResult.ErrorMessage ?? "Could not load questions.";
                _questions = [];
            }
        }
        catch (OperationCanceledException)
        {
            // A newer load superseded this one; keep the latest state.
        }
        catch (Exception ex)
        {
            _error = $"Unexpected error: {ex.Message}";
            _questions = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private Task ReloadAsync() => LoadAsync();

    private string GetStackName(int stackId) =>
        _stackNames.TryGetValue(stackId, out var name) ? name : $"Stack #{stackId}";

    private static int LevelRank(string? level) => level?.Trim().ToLowerInvariant() switch
    {
        "junior" => 0,
        "mid" or "middle" or "mid-level" => 1,
        "senior" => 2,
        _ => 3
    };

    private List<QuestionResponse> FilteredQuestions
    {
        get
        {
            IEnumerable<QuestionResponse> query = _questions;

            if (!string.IsNullOrWhiteSpace(_searchString))
            {
                query = query.Where(q =>
                    q.Question.Contains(_searchString, StringComparison.OrdinalIgnoreCase)
                    || (q.AcceptableAnswer?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            if (_stackFilter is { } stackId)
            {
                query = query.Where(q => q.StackId == stackId);
            }

            if (!string.IsNullOrWhiteSpace(_levelFilter))
            {
                query = query.Where(q => string.Equals(q.Level, _levelFilter, StringComparison.OrdinalIgnoreCase));
            }

            query = _sort switch
            {
                QuestionSort.Level => query.OrderBy(q => LevelRank(q.Level)).ThenBy(q => GetStackName(q.StackId)),
                _ => query.OrderBy(q => GetStackName(q.StackId)).ThenBy(q => LevelRank(q.Level))
            };

            return (_descending ? query.Reverse() : query).ToList();
        }
    }

    private async Task OpenCreateDialogAsync()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<QuestionDialog>("Add question", options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task OpenDetailsAsync(QuestionResponse question)
    {
        // Exercise GET /api/questions/get/{id} so the details reflect the freshest server state.
        var detailResult = await QuestionApi.GetQuestionByIdAsync(question.Id);
        var detail = detailResult is { Success: true, Data: not null } ? detailResult.Data : question;

        var parameters = new DialogParameters<QuestionDialog>
        {
            { x => x.Question, detail },
            { x => x.ReadOnly, true }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<QuestionDialog>("Question details", parameters, options);
    }

    private async Task OpenEditDialogAsync(QuestionResponse question)
    {
        var parameters = new DialogParameters<QuestionDialog>
        {
            { x => x.Question, question }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<QuestionDialog>("Edit question", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task ConfirmDeleteAsync(QuestionResponse question)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete question",
            "Are you sure you want to delete this question? This performs a soft delete on the server.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed != true)
        {
            return;
        }

        var result = await QuestionApi.DeleteQuestionAsync(question.Id);
        if (result.Success)
        {
            Snackbar.Add("Question deleted.", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? "Could not delete the question.", Severity.Error);
        }
    }

    private void Apply(Action mutate)
    {
        mutate();
        StateHasChanged();
    }

    public void Dispose() => _cts?.Cancel();
}
